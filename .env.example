# Model in "<provider>:<model>" form, e.g.
#   google_genai:gemini-3.8-flash (free tier) | openai:gpt-4o-mini | anthropic:claude-sonnet-4-5
#   groq:llama-3.3-70b-versatile | ollama:llama3.1
LLM_MODEL=google_genai:gemini-3.8-flash
# Tried in order if the primary model is temporarily unavailable.
LLM_FALLBACK_MODELS=google_genai:gemini-3.7-flash,google_genai:gemini-3.6-flash
LLM_TEMPERATURE=0
# Fail fast, then use the next model instead of retrying one overloaded model for minutes.
LLM_MAX_RETRIES=0
LLM_TIMEOUT_SECONDS=25
LLM_REASONING_EFFORT=low

# Provider credentials (only the one you use is required)
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

DATA_DIR=data
MAX_AGENT_STEPS=25
LOG_LEVEL=WARNING
